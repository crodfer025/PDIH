%!
%%Pages: 2
%%Page: 1 1
% Titulo de la pagina
/Helvetica-Bold findfont 16 scalefont setfont
0 setgray
100 650 moveto
(Mi tabla de datos) show

%Dibujo de la cuadricula de la tabla
newpath
0.5 setlinewidth

% Lineas horizontales
100 600 moveto 400 0 rlineto stroke  % Fila superior
100 550 moveto 400 0 rlineto stroke  % Fila central (separador)
100 500 moveto 400 0 rlineto stroke  % Fila inferior

% Lineas verticales
100 600 moveto 0 -100 rlineto stroke % Borde izquierdo
300 600 moveto 0 -100 rlineto stroke % Separador central
500 600 moveto 0 -100 rlineto stroke % Borde derecho

% Texto dentro de las celdas
/Helvetica findfont 14 scalefont setfont

% Cabeceras (Fila 1)
110 570 moveto
(Columna 1) show
310 570 moveto
(Columna 2) show

% Datos (Fila 2)
110 520 moveto
(45) show
310 520 moveto
(21) show

% Finalizamos la Pagina 1
showpage 
%%Page: 2 2

% Página 2, la Gráfica

%Titulo de la pagina
/Helvetica-Bold findfont 16 scalefont setfont
0 setgray
100 650 moveto
(La grafica) show

%Dibujo de los Ejes X e Y
newpath
1 setlinewidth
0.7 setgray                 % Gris para los ejes

100 400 moveto              % Origen de la grafica
0 200 rlineto stroke        % Eje Y

100 400 moveto              % Volvemos al origen
400 0 rlineto stroke        % Eje X

% Trazado de la Grafica en cresta
newpath
0.8 0.2 0.2 setrgbcolor     % Color rojizo para la linea de datos
2 setlinewidth

120 480 moveto              % Punto 1 (inicio)
180 430 lineto              % Punto 2 (bajada)
260 550 lineto              % Punto 3 (subida fuerte)
340 450 lineto              % Punto 4 (bajada)
420 560 lineto              % Punto 5 (subida final)
stroke                      % Pintamos la linea unida

% Puntos de datos (Circulitos en los vertices)
newpath
120 480 3 0 360 arc fill
180 430 3 0 360 arc fill
260 550 3 0 360 arc fill
340 450 3 0 360 arc fill
420 560 3 0 360 arc fill

showpage